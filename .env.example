# Copy to .env and adjust locally — never commit .env
# PROXY_SERVER=http://user:pass@host:port

# Slow down requests to reduce blocks (seconds)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# Run browser visibly (recommended — DrissionPage uses real Chrome)
HEADLESS=false

# Extra seconds to wait if Cloudflare needs manual click (visible browser only)
CF_MANUAL_WAIT_SEC=120
